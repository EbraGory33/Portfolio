# See https://help.github.com/articles/ignoring-files/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# local OS files
Thumbs.db

# temporary files
*.tmp
*.temp

# cache
.cache/
.turbo/

# package manager
.npm/
.pnpm-store/

# next telemetry (optional)
.next/cache

# local databases (if you add SQLite later)
*.sqlite
*.sqlite3
# Sentry Config File
.env.sentry-build-plugin
